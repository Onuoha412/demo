APP_NAME=QueueLess API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DATABASE_URL=sqlite:///./queueless.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
SQLITE_BUSY_TIMEOUT_MS=30000
SQLITE_SYNCHRONOUS=NORMAL
DATABASE_BACKUP_DIR=./backups
DATABASE_BACKUP_INTERVAL_HOURS=24
DATABASE_BACKUP_RETENTION_COUNT=7
REDIS_URL=
REALTIME_PUBSUB_CHANNEL=queueless:realtime
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-bytes
JWT_SECRET=replace-with-a-different-unique-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
SESSION_EXPIRE_DAYS=14
SESSION_COOKIE_NAME=queueless_session
SESSION_COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:5173
SUPER_ADMIN_EMAIL=
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
RESET_PASSWORD_URL=http://localhost:5173/reset-password
AUTH_RATE_LIMIT_LOGIN=10
AUTH_RATE_LIMIT_REGISTER=5
AUTH_RATE_LIMIT_RESET=5
REALTIME_CHANNEL_PREFIX=queueless:queue:
REALTIME_QUEUE_CONNECTION_LIMIT=1000
NOTIFICATION_APPROACHING_THRESHOLD=3
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
